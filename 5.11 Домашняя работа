<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Карточка сотрудника</title>
</head>
<body>

    <button id="showBtn">Показать карточку (Событие)</button>

    <script src="5.11.js"></script>
</body>
</html>



const employee = {
    name: 'Иван',
    position: 'Frontend-разработчик',
    department: 'IT-отдел',

    showCard() {
        console.log(`Сотрудник: ${this.name}, Должность: ${this.position}, Отдел: ${this.department}`);
    }
};
console.log("--- 3. Вызов как метода объекта ---");
employee.showCard();
console.log("--- 4. Сохранение в переменную (потеря контекста) ---");
const detachedShowCard = employee.showCard;
detachedShowCard();
console.log("--- 5. Исправление через bind() ---");
const boundShowCard = employee.showCard.bind(employee);
boundShowCard();
console.log("--- 6. Вызовы call() и apply() ---");
function showCardInCity(city) {
    console.log(`Сотрудник: ${this.name}, Город: ${city}`);
}
showCardInCity.call(employee, 'Москва');
showCardInCity.apply(employee, ['Санкт-Петербург']);
console.log("--- 7. Обработчики событий ---");
const btn = document.getElementById('showBtn');
btn.addEventListener('click', function(event) {
    console.log("Обычная функция:");
    console.log("this:", this);
    console.log("event.currentTarget:", event.currentTarget);
});
btn.addEventListener('click', (event) => {
    console.log("Стрелочная функция:");
    console.log("this:", this);
    console.log("event.currentTarget:", event.currentTarget);
});
