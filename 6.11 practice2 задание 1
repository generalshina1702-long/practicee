function checkWeather(temperature) {
    return new Promise((resolve, reject) => {

        setTimeout(() => {

            if (temperature > 0) {
                resolve("Тепло!");
            } else {
                reject(new Error("Холодно!"));
            }

        }, 1000);
    });
}

console.log("Проверяем погоду с температурой 5...");
checkWeather(5)
    .then((result) => {
        console.log("Успех (then):", result);
    })
    .catch((error) => {
        console.log("Ошибка (catch):", error.message);
    });

console.log("Проверяем погоду с температурой -5...");
checkWeather(-5)
    .then((result) => {
        console.log("Успех (then):", result);
    })
    .catch((error) => {
        console.log("Ошибка (catch):", error.message);
    });
